rules_version = '2';
// Firestore security rules for DIP Practicals 14-15 (all collections start with dip_).
//
// HOW TO USE (see DEPLOY.md, Part B):
//  - Firebase project used ONLY for DIP: paste this whole file into Firestore > Rules and Publish.
//  - Firebase project SHARED with another lab (for example the Scientific Python lab, sp_ collections):
//    do NOT replace that lab's rules. Copy only the lines between "BEGIN DIP" and "END DIP" and paste
//    them inside the existing  match /databases/{database}/documents { ... }  block, just before its
//    last closing brace. Then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================= BEGIN DIP =======================
    // Teacher Google accounts (lowercase). Add more inside the brackets, separated by commas.
    function dipIsTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['poojan.shah@rru.ac.in'];
    }
    // Who may register as a student. To allow only college accounts, add for example:
    //   && request.auth.token.email.matches('.*@student[.]rru[.]ac[.]in$')
    function dipStudentOk() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function dipMaxAttempts() { return 4; }   // keep equal to window.GRADING.maxAttempts in config.js
    function dipD() { return request.resource.data; }
    function dipUserAfter() {
      return getAfter(/databases/$(database)/documents/dip_users/$(request.auth.uid)).data;
    }
    function dipRegistered() {
      return request.auth != null
        && existsAfter(/databases/$(database)/documents/dip_users/$(request.auth.uid));
    }
    function dipTaskIds() { return ['t14a', 't14b', 't14c', 't15a', 't15b', 'exit']; }

    // ---- Student profile: created once by the student; only the teacher can change or delete it.
    match /dip_users/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || dipIsTeacher();
      allow list: if dipIsTeacher();
      allow create: if dipStudentOk() && request.auth.uid == uid
        && dipD().keys().hasOnly(['uid', 'name', 'enrollment', 'division', 'email', 'createdAt'])
        && dipD().keys().hasAll(['uid', 'name', 'enrollment', 'division', 'email', 'createdAt'])
        && dipD().uid == uid
        && dipD().email == request.auth.token.email
        && dipD().name is string && dipD().name.matches("^[A-Za-z][A-Za-z .'-]{1,59}$")
        && dipD().enrollment is string && dipD().enrollment.matches('^[A-Z0-9]{4,20}$')
        && dipD().division is string && dipD().division.size() <= 40
        && dipD().createdAt == request.time
        && getAfter(/databases/$(database)/documents/dip_enrollments/$(dipD().enrollment)).data.uid == uid;
      allow update, delete: if dipIsTeacher();
    }

    // ---- Enrollment numbers are unique: claimed once, released only by the teacher.
    match /dip_enrollments/{enr} {
      allow read: if dipIsTeacher();
      allow create: if dipStudentOk()
        && dipD().keys().hasOnly(['uid', 'createdAt'])
        && dipD().uid == request.auth.uid
        && dipD().createdAt == request.time
        && getAfter(/databases/$(database)/documents/dip_users/$(request.auth.uid)).data.enrollment == enr;
      allow update, delete: if dipIsTeacher();
    }

    // ---- One progress record per student: name/enrollment/division copied from the profile,
    //      step ticks, code peeks ("solutions seen") and typed-but-unchecked answers. No marks here.
    match /dip_progress/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || dipIsTeacher();
      allow list: if dipIsTeacher();
      allow create, update: if request.auth != null && request.auth.uid == uid && dipRegistered()
        && dipD().keys().hasOnly(['uid', 'name', 'enrollment', 'division', 'steps', 'peeks', 'answers', 'updatedAt'])
        && dipD().uid == uid
        && dipD().name == dipUserAfter().name
        && dipD().enrollment == dipUserAfter().enrollment
        && dipD().division == dipUserAfter().division
        && dipD().steps is map && dipD().steps.size() <= 6
        && dipD().peeks is map && dipD().peeks.size() <= 60
        && dipD().answers is map && dipD().answers.size() <= 6
        && dipD().updatedAt == request.time;
      allow delete: if dipIsTeacher();
    }

    // ---- Auto-graded answers: dip_attempts/{uid}__{taskId}__{questionId}
    // The student sends the answer AND a "correct" flag. The write is accepted only if the flag
    // matches the hidden key in dip_config/answerKey, so it cannot be faked. A correct answer is
    // final; a wrong one can be retried until dipMaxAttempts().
    function dipKeyQ(tid, qid) {
      return get(/databases/$(database)/documents/dip_config/answerKey).data.tasks[tid][qid];
    }
    function dipIsRight(k, a) {
      return (k.type == 'num' && a is number && math.abs(a - k.value) <= math.abs(k.value) * k.tol)
          || (k.type == 'choice' && a is string && a == k.value);
    }
    function dipValidAttempt(aid) {
      let k = dipKeyQ(dipD().tid, dipD().qid);
      return dipD().keys().hasOnly(['uid', 'tid', 'qid', 'ans', 'n', 'correct', 'at'])
        && dipD().keys().hasAll(['uid', 'tid', 'qid', 'ans', 'n', 'correct', 'at'])
        && dipD().uid == request.auth.uid
        && dipD().tid in dipTaskIds()
        && dipD().qid is string
        && aid == request.auth.uid + '__' + dipD().tid + '__' + dipD().qid
        && (dipD().ans is number || (dipD().ans is string && dipD().ans.size() <= 40))
        && dipD().n is int && dipD().n >= 1 && dipD().n <= dipMaxAttempts()
        && dipD().at == request.time
        && dipD().correct == dipIsRight(k, dipD().ans);
    }
    match /dip_attempts/{aid} {
      allow get, list: if dipIsTeacher()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if dipRegistered() && dipValidAttempt(aid) && dipD().n == 1;
      allow update: if dipIsTeacher()
        || (dipRegistered()
            && resource.data.uid == request.auth.uid
            && resource.data.correct == false
            && dipValidAttempt(aid)
            && dipD().n == resource.data.n + 1);
      allow delete: if dipIsTeacher();
    }

    // ---- Teacher-only: the answer key.
    match /dip_config/{doc} { allow read, write: if dipIsTeacher(); }
    // ======================== END DIP ========================
  }
}
